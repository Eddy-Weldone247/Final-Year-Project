{
  "expo": {
    "name": "ExpenSee",
    "slug": "expensee",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "expensee",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.expensee.app"
    },
    "android": {
      "package": "com.expensee.app",
      "permissions": [
        "android.permission.READ_SMS",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "apiUrl": "http://localhost:4000/api",
      "eas": {
        "projectId": "9bcc56dc-af8f-4c32-845b-f3a7b0b20b38"
      }
    },
    "plugins": [
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow ExpenSee to access your photos to set a profile picture."
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "color": "#2563eb"
        }
      ]
    ],
    "owner": "eddymadrids-team"
  }
}
