# Server
NODE_ENV=development
PORT=4000

# Public base URL of this API (used in email-verification links)
API_URL=http://localhost:4000/api

# Public base URL of the client app
CLIENT_URL=http://localhost:8081

# Python ML microservice (FastAPI) base URL
ML_SERVICE_URL=http://localhost:8000

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/expensee?schema=public"

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Admin — default email for `npm run promote-admin` (also accepts an email arg)
ADMIN_EMAIL=

# CORS (Expo dev server default origin)
CORS_ORIGIN=http://localhost:8081

# Email / SMTP
# Leave SMTP_HOST empty in development to log emails to the console instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="ExpenSee <no-reply@expensee.app>"
